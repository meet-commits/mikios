# Server Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://mikios.vercel.app
ALLOWED_ORIGINS=https://mikios.vercel.app

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://mikios-backend.onrender.com/api/auth/google/callback


# JWT Configuration
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
SOCKET_CORS_ORIGIN=https://mikios.vercel.app

